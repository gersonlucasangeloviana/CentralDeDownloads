# ECS: configurar estes valores como segredos/variáveis de ambiente por serviço.
Storage__Provider=MongoDB
# Use Storage__Provider=PostgreSQL na API e no worker para usar PostgreSQL.
Postgres__ConnectionString=Host=postgres.example.internal;Port=5432;Database=gerador_excel;Username=gerador;Password=troque-esta-senha
Mongo__ConnectionString=mongodb+srv://usuario:senha@cluster.mongodb.net/
Mongo__Database=gerador_excel
Aws__Region=sa-east-1
Aws__Bucket=nome-do-bucket
# Use o mesmo Queue__Provider na API e no worker: SQS ou RabbitMQ.
Queue__Provider=SQS
Aws__QueueUrl=https://sqs.sa-east-1.amazonaws.com/CONTA/fila-gerador-excel
RabbitMq__Uri=amqps://usuario:senha@rabbitmq.exemplo.com:5671/
RabbitMq__QueueName=gerador-excel
Security__ApiKey=troque-por-uma-chave-de-32-caracteres
Security__DownloadSigningKey=troque-por-um-segredo-aleatorio-de-64-caracteres
Swagger__Enabled=true
PublicBaseUrl=https://api.exemplo.com
Download__LinkHours=3
Resend__ApiKey=re_...
Resend__From=arquivos@exemplo.com
# Portal
Portal__Password=troque-por-uma-senha-forte
Api__BaseUrl=http://api-interno:8080
Api__Key=mesmo-valor-de-Security__ApiKey
