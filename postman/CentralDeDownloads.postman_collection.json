{
  "info": {
    "name": "CentralDeDownloads - fluxos de geração",
    "description": "Dois roteiros executáveis: CSV com um lote e XLSX com três lotes. Configure baseUrl e apiKey nas variáveis da coleção e execute uma pasta no Collection Runner com Delay de 2000 ms.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Simples: CSV com 1 lote",
      "description": "5 chamadas: criar, enviar, concluir, consultar e baixar.",
      "item": [
        {
          "name": "01 Criar CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/arquivos",
            "description": "Cria um CSV sem período nem notificações. Guarde o id capturado automaticamente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Exemplo Postman - 1 lote\",\n  \"formato\": \"csv\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Criação retorna 201\", () => pm.response.to.have.status(201));",
                  "let job = {};",
                  "try { job = pm.response.json(); } catch (error) {}",
                  "pm.test(\"Resposta contém id e status recebendo\", () => {",
                  "    pm.expect(job.id).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(job.status).to.eql(\"recebendo\");",
                  "});",
                  "if (pm.response.code === 201 && job.id) {",
                  "    pm.collectionVariables.set(\"simpleJobId\", job.id);",
                  "    pm.collectionVariables.unset(\"simpleDownloadUrl\");",
                  "    pm.collectionVariables.set(\"simplePollCount\", \"0\");",
                  "} else {",
                  "    pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Enviar lote único",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/arquivos/{{simpleJobId}}/lotes",
            "description": "Dois pedidos planos. Não envie mais de 100 registros em um lote.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{simpleJobId}}\",\n  \"dados\": [\n    {\n      \"Pedido\": \"PED-1001\",\n      \"Cliente\": \"Ana\",\n      \"Valor\": 149.9\n    },\n    {\n      \"Pedido\": \"PED-1002\",\n      \"Cliente\": \"Bia\",\n      \"Valor\": 250.0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lote retorna 202\", () => pm.response.to.have.status(202));",
                  "let batch = {};",
                  "try { batch = pm.response.json(); } catch (error) {}",
                  "pm.test(\"Lote e sequência confirmados\", () => {",
                  "    pm.expect(batch.id).to.eql(pm.collectionVariables.get(\"simpleJobId\"));",
                  "    pm.expect(batch.sequencia).to.eql(1);",
                  "    pm.expect(batch.totalItens).to.eql(2);",
                  "});",
                  "if (pm.response.code !== 202) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Concluir com totais",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/arquivos/{{simpleJobId}}/concluir",
            "description": "Conclui o envio. Totais divergentes causam falha permanente do trabalho.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalLotes\": 1,\n  \"totalItens\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Conclusão retorna 202\", () => pm.response.to.have.status(202));",
                  "let job = {};",
                  "try { job = pm.response.json(); } catch (error) {}",
                  "pm.test(\"Totais recebidos sem divergência\", () => {",
                  "    pm.expect(job.totalLotes).to.eql(1);",
                  "    pm.expect(job.totalItens).to.eql(2);",
                  "    pm.expect(job.status).not.to.eql(\"falhou\");",
                  "});",
                  "if (pm.response.code !== 202) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Consultar status até pronto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/v1/arquivos/{{simpleJobId}}",
            "description": "No Collection Runner, repete esta consulta enquanto o worker processa. Não reenvia lotes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Consulta retorna 200\", () => pm.response.to.have.status(200));",
                  "let job = {};",
                  "try { job = pm.response.json(); } catch (error) {}",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "} else if (job.status === \"pronto\") {",
                  "    pm.test(\"Arquivo pronto com totais corretos e link\", () => {",
                  "        pm.expect(job.totalLotes).to.eql(1);",
                  "        pm.expect(job.totalItens).to.eql(2);",
                  "        pm.expect(job.linkDownload).to.match(/^https?:\\/\\//);",
                  "    });",
                  "    if (job.linkDownload) pm.collectionVariables.set(\"simpleDownloadUrl\", job.linkDownload);",
                  "    else pm.execution.setNextRequest(null);",
                  "} else if (job.status === \"falhou\" || job.status === \"expirou\") {",
                  "    pm.test(\"Geração sem erro\", () => { throw new Error(job.erro || job.status); });",
                  "    pm.execution.setNextRequest(null);",
                  "} else {",
                  "    const count = Number(pm.collectionVariables.get(\"simplePollCount\") || 0) + 1;",
                  "    pm.collectionVariables.set(\"simplePollCount\", String(count));",
                  "    if (count >= 180) {",
                  "        pm.test(\"Arquivo pronto em até 180 consultas\", () => { throw new Error(\"Último status: \" + job.status); });",
                  "        pm.execution.setNextRequest(null);",
                  "    } else {",
                  "        pm.test(\"Status de processamento válido\", () =>",
                  "            pm.expect([\"recebendo\", \"fechando\", \"na_fila\", \"processando\"]).to.include(job.status));",
                  "        pm.execution.setNextRequest(pm.info.requestId);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Baixar CSV pelo link",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{simpleDownloadUrl}}",
            "description": "Abre linkDownload, sem X-Api-Key. Mantenha Follow redirects ativado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Download retorna 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"CSV contém cabeçalho e duas linhas\", () => {",
                  "    const rows = pm.response.text().replace(/^\\uFEFF/, \"\").trimEnd().split(/\\r?\\n/);",
                  "    pm.expect(rows).to.have.lengthOf(3);",
                  "    pm.expect(rows[0]).to.eql(\"Pedido;Cliente;Valor\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
