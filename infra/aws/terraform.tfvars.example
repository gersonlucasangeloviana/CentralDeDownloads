# Copie para terraform.tfvars. Esse arquivo contém apenas escolhas, nunca senhas.
aws_region  = "us-east-1"
environment = "prod"
api_domain    = "apiga.vianadev.com.br"
portal_domain = "ga.vianadev.com.br"

# Primeiro apply: somente a base; sem tasks em execução.
deploy_app = false

